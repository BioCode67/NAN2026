# 이 파일을 .env.local 로 복사하고 키를 채우면 된다.
#   cp .env.example .env.local
# .env.local 은 .gitignore에 걸려 있어 커밋되지 않는다.

# 스프라이트 시트 자동 생성(나노바나나)용 Gemini API 키
#   발급: https://aistudio.google.com/apikey
#   주의: 이미지 생성은 무료 티어가 없다. 장당 $0.039~0.134 (모델에 따라)
GEMINI_API_KEY=

# 사용할 이미지 모델 (선택)
#   gemini-2.5-flash-image   나노바나나 1세대, 가장 저렴 ($0.039/장)
#   gemini-3.1-flash-image   나노바나나 2 (기본값, $0.067/장 @1K)
#   gemini-3-pro-image       가장 품질 높음 ($0.134/장 @1K)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── 어디에 그림을 시킬 것인가 ─────────────────────────────────────
# 기본은 gemini. 무료로 쓰려면 아래 중 하나를 고른다.
#   ART_PROVIDER=pollinations   키 없이 바로. 배경 한 장짜리에 적합
#   ART_PROVIDER=cloudflare     하루 무료 할당량. CF_ACCOUNT_ID + CF_API_TOKEN 필요
#   ART_PROVIDER=huggingface    무료 한도. HF_TOKEN 필요
#
# 주의: 캐릭터 시트(6칸 · 같은 인물 7묶음)는 무료 모델로는 거의 안 나온다.
#       "칸을 세고 인물을 유지하는 것"은 그림 실력이 아니라 지시를 따르는
#       능력이고, 참조 이미지를 받을 수 있어야 한다. 시트는 gemini 를 쓸 것.
# ART_PROVIDER=pollinations

# Cloudflare Workers AI (https://dash.cloudflare.com → AI → Workers AI)
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# Hugging Face (https://huggingface.co/settings/tokens)
# HF_TOKEN=
