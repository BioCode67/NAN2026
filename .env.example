# 문장 → 그림 (Stable Diffusion). 비워 두면 기능이 꺼진 채로 게임이 정상 동작한다.
# 자세한 설명: docs/그림서버-붙이는-법.md

# 로컬 WebUI (AUTOMATIC1111 / Forge) — ./webui.sh --api --cors-allow-origins=*
# VITE_SD_URL=http://127.0.0.1:7860
# VITE_SD_MODE=a1111

# Stability AI
# VITE_SD_URL=https://api.stability.ai
# VITE_SD_MODE=stability
# VITE_SD_KEY=sk-...
# VITE_SD_ENGINE=stable-diffusion-xl-1024-v1-0

# 직접 만든 중계 서버
# VITE_SD_URL=https://my-relay.example.com/draw
# VITE_SD_MODE=generic

# VITE_SD_WIDTH=1024
# VITE_SD_HEIGHT=576
# VITE_SD_STEPS=18
# VITE_SD_TIMEOUT=25000
