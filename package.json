{
  "name": "delisting-brawl",
  "version": "0.1.0",
  "description": "상장폐지 대난투 (Delisting Brawl) - 2D SD 대난투 게임",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sheet": "node tools/process-sheet.mjs",
    "smoke": "node tools/smoke.mjs"
  },
