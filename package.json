{
  "name": "delisting-brawl",
  "version": "0.1.0",
  "description": "상장폐지 대난투 (Delisting Brawl) - 2D SD 대난투 게임",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen": "node tools/gen-sheet.mjs",
    "sheet": "node tools/process-sheet.mjs",
    "smoke": "node tools/smoke.mjs",
    "test:prompt": "node --experimental-strip-types tools/test-prompts.mjs",
    "test:sheet": "node --experimental-strip-types tools/test-sheet.mjs",
    "test:ai": "node --experimental-strip-types tools/test-ai.mjs",
    "test:char": "node tools/test-roster.mjs",
    "char:new": "node tools/new-character.mjs",
    "test": "npm run typecheck && npm run test:prompt && npm run test:sheet && npm run test:ai && npm run test:char && npm run test:net && npm run balance",
    "prompts": "node tools/gen-prompts.mjs",
    "art": "node tools/gen-art.mjs",
    "art:in": "node tools/art-in.mjs",
    "art:opt": "node tools/optimize-art.mjs",
    "docs": "node tools/make-pdf.mjs",
    "sheet:merge": "node tools/merge-sheets.mjs",
    "balance": "node --experimental-transform-types --no-warnings --import ./tools/ts-resolve.mjs tools/balance.mjs",
    "art:check": "node tools/art-check.mjs",
    "smoke:online": "node tools/smoke-online.mjs",
    "test:net": "node --experimental-transform-types --no-warnings --import ./tools/ts-resolve.mjs tools/test-net.mjs",
    "art:jpg": "node tools/jpg-to-png.mjs",
    "art:md": "node tools/gen-prompts.mjs > /dev/null && node tools/prompt-page.mjs",
    "test:audio": "node tools/test-audio.mjs"
  },
  "keywords": [
    "phaser",
    "typescript",
    "game",
    "brawler"
  ],
  "license": "MIT",
  "dependencies": {
    "peerjs": "^1.5.5",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
